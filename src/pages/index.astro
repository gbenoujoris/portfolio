---
import Base from '../layouts/Base.astro';
import CarteProjet from '../components/CarteProjet.astro';
import { getCollection } from 'astro:content';
import { profil } from '../data/profil';

const phares = (await getCollection('projets'))
  .filter((p) => p.data.phare)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const [avantIA, apresIA] = profil.titre.split('IA');
---
<Base>
  <section class="hero">
    <div class="hero-fond" aria-hidden="true"></div>
    <p class="hero-badge reveal">Ingénieur · Automatisme · IA</p>
    <h1 class="reveal">{avantIA}{apresIA !== undefined ? <span class="texte-degrade">IA</span> : null}{apresIA}</h1>
    <p class="sous-titre reveal">{profil.accroche}</p>
    <div class="boutons reveal">
      <a class="bouton principal" href="/projets/">Voir mes projets</a>
      <a class="bouton" href={profil.cv}>Télécharger mon CV</a>
      <a class="bouton" href={profil.liens.linkedin}>LinkedIn</a>
    </div>
  </section>

  <h2 class="reveal">Projets phares</h2>
  <div class="grille">
    {phares.map((p, i) => <div class="reveal" style={`--delai: ${i * 100}ms`}><CarteProjet projet={p} /></div>)}
  </div>
  <p><a class="lien-fleche" href="/projets/">Voir tous les projets <span aria-hidden="true">→</span></a></p>

  <h2 class="reveal">Qui suis-je ?</h2>
  <p class="sous-titre reveal">{profil.presentation}</p>
  <p><a class="lien-fleche" href="/a-propos/">Mon parcours complet <span aria-hidden="true">→</span></a></p>
</Base>
