---
import type { CollectionEntry } from 'astro:content';

interface Props {
  projet: CollectionEntry<'projets'>;
}
const { projet } = Astro.props;
const { titre, resume, image, domaines, statut } = projet.data;
---
<a class="carte" href={`/projets/${projet.id}/`} data-domaines={domaines.join('|')}>
  {image && <img src={image} alt={titre} loading="lazy" />}
  <div class="contenu">
    <div class="etiquettes">
      {domaines.map((d) => <span class="etiquette">{d}</span>)}
      {statut === 'en cours' && <span class="statut">En cours</span>}
    </div>
    <h3>{titre}</h3>
    <p>{resume}</p>
  </div>
</a>
